# Copie para .env e preencha. NUNCA publique o .env.

PORT=3000
NODE_ENV=production

# Senha do painel /admin.html (obrigatória em produção; use algo longo)
ADMIN_PASSWORD=troque-esta-senha-por-uma-forte
# Chave para assinar a sessão do admin. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa

# Caminho do banco SQLite. Em hospedagem, aponte para um DISCO PERSISTENTE (ex.: /var/data/atelie.db)
DB_FILE=./data/atelie.db

# Só se o site estiver em OUTRO domínio que a API (origens separadas por vírgula)
# CORS_ORIGINS=https://www.seudominio.com.br

# E-mail opcional via Resend (resend.com): o salão recebe aviso de cada agendamento/contato
# e o cliente recebe confirmação quando informa e-mail.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="Ateliê da Beleza <agendamentos@seudominio.com.br>"
# MAIL_TO=salao@seudominio.com.br
